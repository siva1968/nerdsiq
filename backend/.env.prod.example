# NerdsIQ Production Environment Configuration
# Copy to .env.prod and fill in PRODUCTION values

# Application
APP_ENV=production
SECRET_KEY=<GENERATE_NEW_32_CHAR_SECRET>
DEBUG=false

# Database (PostgreSQL)
# Note: DATABASE_URL is set in docker-compose.prod.yml using these values
POSTGRES_USER=nerdsiq
POSTGRES_PASSWORD=<STRONG_PRODUCTION_PASSWORD>
POSTGRES_DB=nerdsiq

# OpenAI (same key works for prod, but consider separate for billing tracking)
OPENAI_API_KEY=<YOUR_OPENAI_API_KEY>
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Qdrant Vector Database
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=nerdsiq_docs

# Google Drive
GOOGLE_OAUTH_CLIENT_FILE=./credentials/oauth-client.json
GOOGLE_OAUTH_TOKEN_FILE=./credentials/oauth-token.json
GOOGLE_DRIVE_FOLDER_ID=<YOUR_GOOGLE_DRIVE_FOLDER_ID>

# JWT Authentication (GENERATE NEW SECRETS FOR PRODUCTION!)
JWT_SECRET_KEY=<GENERATE_NEW_32_CHAR_SECRET>
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# WordPress SSO (must match WordPress plugin settings)
WP_AUTH_SECRET=<GENERATE_NEW_SECRET_MATCHING_WORDPRESS>

# CORS (production WordPress URL only)
CORS_ORIGINS=https://www.atiserve.com

# Rate Limiting
RATE_LIMIT_PER_MINUTE=30

# Logging
LOG_LEVEL=INFO

# Cloudflare Tunnel Token (from Cloudflare Zero Trust dashboard)
CLOUDFLARE_TUNNEL_TOKEN=<YOUR_TUNNEL_TOKEN>
