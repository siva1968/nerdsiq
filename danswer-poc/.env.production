# Production Environment Configuration for Danswer
# Copy to .env and fill in production values

# ============================================================================
# REQUIRED SETTINGS
# ============================================================================

# OpenAI API Key (same as current NerdsIQ system)
OPENAI_API_KEY=sk-your-production-key-here

# PostgreSQL strong password (generate with: openssl rand -base64 32)
POSTGRES_PASSWORD=

# JWT Secret Key (generate with: openssl rand -base64 64)
SECRET_KEY=

# Web domain (your production URL)
WEB_DOMAIN=https://nerdsiq.atiserve.com
# Or: WEB_DOMAIN=https://danswer.atiserve.com

# ============================================================================
# OPTIONAL PERFORMANCE TUNING
# ============================================================================

# Number of indexing workers (increase for faster document processing)
NUM_INDEXING_WORKERS=2

# Number of secondary indexing workers
NUM_SECONDARY_INDEXING_WORKERS=1

# ============================================================================
# OPTIONAL LLM CONFIGURATION
# ============================================================================

# LLM Provider (default: openai)
# Options: openai, anthropic, cohere, azure
GEN_AI_MODEL_PROVIDER=openai

# Model version (default: gpt-4o-mini for cost efficiency)
# Options: gpt-4o-mini, gpt-4, gpt-4-turbo, gpt-3.5-turbo
GEN_AI_MODEL_VERSION=gpt-4o-mini

# Embedding model (default: text-embedding-3-small)
EMBEDDING_MODEL=text-embedding-3-small

# ============================================================================
# OPTIONAL AUTHENTICATION
# ============================================================================

# Auth type (default: basic username/password)
# Options: basic, google_oauth, oidc, saml, disabled
AUTH_TYPE=basic

# Disable authentication entirely (NOT recommended for production)
DISABLE_AUTH=false

# Google OAuth (if using google_oauth auth type)
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# ============================================================================
# OPTIONAL BRANDING
# ============================================================================

# Custom logo URL (NerdsToGo logo)
CUSTOM_LOGO_URL=https://www.atiserve.com/wp-content/uploads/nerdstoqgo-logo.png

# Custom header content
CUSTOM_HEADER_CONTENT=NerdsIQ

# Custom app name
CUSTOM_APP_NAME=NerdsIQ

# ============================================================================
# OPTIONAL RATE LIMITING & SECURITY
# ============================================================================

# Rate limit per user (requests per minute)
RATE_LIMIT_PER_MINUTE=30

# Session timeout (minutes)
SESSION_TIMEOUT_MINUTES=60

# Enable HTTPS only
REQUIRE_HTTPS=true

# CORS allowed origins (comma-separated)
CORS_ORIGINS=https://www.atiserve.com,https://atiserve.com

# ============================================================================
# OPTIONAL MONITORING & LOGGING
# ============================================================================

# Log level (options: debug, info, warning, error)
LOG_LEVEL=warning

# Enable metrics endpoint
ENABLE_METRICS=true

# Sentry DSN for error tracking (optional)
# SENTRY_DSN=

# ============================================================================
# OPTIONAL BACKUP CONFIGURATION
# ============================================================================

# S3 bucket for backups (if using cloud storage)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=nerdsiq-backups
# AWS_REGION=us-east-1

# ============================================================================
# GOOGLE DRIVE CONNECTOR (configured in UI, but can pre-set here)
# ============================================================================

# Service account JSON path (mount as volume in docker-compose)
# GOOGLE_SERVICE_ACCOUNT_FILE=/app/credentials/google-service-account.json

# Drive folder ID to index
# GOOGLE_DRIVE_FOLDER_ID=1abc123def456

# ============================================================================
# ADVANCED SETTINGS (typically don't need to change)
# ============================================================================

# Qdrant collection name
# QDRANT_COLLECTION=danswer

# Vector dimension (must match embedding model)
# VECTOR_DIM=1536

# Max file size for indexing (MB)
# MAX_FILE_SIZE_MB=50

# Reranking model (improves search relevance)
# RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Enable query caching
# ENABLE_QUERY_CACHE=true

# Cache TTL (seconds)
# CACHE_TTL=3600
