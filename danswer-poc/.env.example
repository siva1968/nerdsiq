# Danswer POC Environment Configuration
# Copy this file to .env and fill in your values

# OpenAI API Key (required for embeddings and LLM)
OPENAI_API_KEY=sk-your-openai-api-key-here

# PostgreSQL credentials
POSTGRES_PASSWORD=changeme123

# Secret key for JWT tokens (generate a secure random string)
SECRET_KEY=your-secret-key-change-in-production

# Optional: If you want to use a different LLM provider
# GEN_AI_MODEL_PROVIDER=openai  # Options: openai, anthropic, cohere
# GEN_AI_MODEL_VERSION=gpt-4o-mini

# Optional: Google Drive integration
# GOOGLE_DRIVE_CLIENT_ID=
# GOOGLE_DRIVE_CLIENT_SECRET=
# GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=

# Optional: Authentication settings
# AUTH_TYPE=basic  # Options: basic, google_oauth, oidc, disabled
# DISABLE_AUTH=false

# Optional: Custom branding
# CUSTOM_LOGO_URL=
# CUSTOM_HEADER_CONTENT=NerdsIQ

# Optional: Performance tuning
# NUM_INDEXING_WORKERS=2
# NUM_SECONDARY_INDEXING_WORKERS=1
